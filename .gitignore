# Nextflow run files (scratch, logs, history; regenerated on every run)
work/
.nextflow/
.nextflow.log*

# Pipeline outputs (regenerated by running the pipeline)
results/

# Raw and large data (README explains how to download)
data/
*.fastq.gz
*.fq.gz
*.sra
*.h5ad
*.rds

# Containers (rebuilt from the pinned tags in the config)
*.sif
.apptainer_cache/

# Python / Jupyter
__pycache__/
.ipynb_checkpoints/

# Reference papers (copyrighted; cited in the README instead)
papers/

# Editor and OS files
.vscode/
.DS_Store