// Stub-run test profile: tiny placeholder inputs, small resources (used in CI)
params {
    samplesheet  = "${projectDir}/tests/data/samplesheet_stub.csv"
    genome_fasta = "${projectDir}/tests/data/genome_stub.fa"
    genome_gtf   = "${projectDir}/tests/data/genome_stub.gtf"
    outdir       = 'results_stub'
}

process {
    // Cap every request to what a CI machine has; withName blocks above still apply, up to these limits
    resourceLimits = [cpus: 2, memory: 4.GB, time: 1.h]
}