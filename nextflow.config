// Default resources for every process
process {
    cpus = 2
    memory = '4GB'

    withName: 'FETCH_SRA' {
        cpus        = 4
        memory      = '8 GB'
        time        = '6h'
        maxForks    = 3
    }
}

profiles {
    docker {
        docker.enabled      = true
        docker.runOptions   = '--platform linux/amd64'
    }

    hpc {
        apptainer.enabled   = true
        process {
            executor    = 'slurm'
            queue       = 'cpu_short'
            withName    = 'FETCH_SRA' {
                queue = 'data_mover'
            }
        }
    }
}