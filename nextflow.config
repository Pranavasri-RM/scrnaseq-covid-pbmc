params {
    samplesheet  = "${projectDir}/assets/samplesheet.csv"

    // Human reference: GRCh38 primary assembly, Ensembl release 110 (= GENCODE v44, same as 10x GRCh38-2024-A)
    genome_fasta = 'https://ftp.ensembl.org/pub/release-110/fasta/homo_sapiens/dna/Homo_sapiens.GRCh38.dna.primary_assembly.fa.gz'
    genome_gtf   = 'https://ftp.ensembl.org/pub/release-110/gtf/homo_sapiens/Homo_sapiens.GRCh38.110.gtf.gz'

    // SARS-CoV-2 reference genome, stored in the repo
    virus_fasta  = "${projectDir}/assets/sarscov2/NC_045512.2.fa"
    virus_gtf    = "${projectDir}/assets/sarscov2/NC_045512.2.gtf"
}

// Default resources for every process
process {
    cpus = 2
    memory = '4GB'

    withName: 'KB_REF' {
        cpus   = 8
        memory = '16 GB'
        time   = '2h'
    }

    withName: 'KB_REF' {
        cpus   = 8
        memory = '64 GB'
        time   = '8h'
    }
}

profiles {
    docker {
        docker.enabled      = true
        docker.runOptions   = '--platform linux/amd64'
    }

    hpc {
        includeConfig 'conf/hpc.config'
    }
}
